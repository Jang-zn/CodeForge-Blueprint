{
  "name": "codeforge-blueprint",
  "version": "0.1.2",
  "description": "Transform your idea into a structured PRD with AI-powered review pipeline",
  "author": "CodeForge",
  "type": "module",
  "bin": {
    "codeforge-blueprint": "./dist/cli.js"
  },
  "main": "./dist/electron/main.js",
  "files": [
    "dist/",
    "skills/"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "test": "node --import tsx/esm --test 'tests/*.test.ts' 'tests/**/*.test.ts'",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "electron:dev": "npm run build && electron dist/electron/main.js",
    "electron:build": "npm version patch --no-git-tag-version && npm run build && electron-builder && npm rebuild better-sqlite3"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@hono/node-server": "^1",
    "better-sqlite3": "^12.8.0",
    "fix-path": "^5.0.0",
    "hono": "^4",
    "open": "^10"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "diff": "^8.0.4",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "tsx": "^4",
    "typescript": "^5"
  }
}
